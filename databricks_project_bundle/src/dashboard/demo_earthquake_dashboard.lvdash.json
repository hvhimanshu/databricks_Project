{
  "datasets": [
    {
      "name": "bee607f4",
      "displayName": "earthquake_detail",
      "queryLines": [
        "select * from silver.earthquake_data_final"
      ],
      "catalog": "demo_dev",
      "schema": "default"
    },
    {
      "name": "24c3fd9c",
      "displayName": "Earthquake_type",
      "queryLines": [
        "select count(*) as total_magnitude_bucket, magnitude_bucket from (\r\n",
        "    select CASE\r\n",
        "    when mag < 2 then 'Micro (<2)'\r\n",
        "    when mag between 2 and 3 then 'Minor (2-3)'\r\n",
        "    when mag between 3 and 4 then 'Light (3-4)'\r\n",
        "    else 'Moderate+ (4+)'\r\n",
        "END AS magnitude_bucket\r\n",
        "from silver.earthquake_data\r\n",
        ")\r\n",
        "group by magnitude_bucket"
      ],
      "catalog": "demo_dev",
      "schema": "default"
    },
    {
      "name": "b7ddfc59",
      "displayName": "Earthquake_country",
      "queryLines": [
        "select\r\n",
        "  count(*) as event_count,\r\n",
        "  CASE\r\n",
        "    WHEN size(split(place, ', ')) = 1 THEN split(place, ', ')[0]\r\n",
        "    ELSE split(place, ', ')[1]\r\n",
        "  END AS country\r\n",
        "from\r\n",
        "  (\r\n",
        "    select\r\n",
        "      time,\r\n",
        "      title,\r\n",
        "      mag,\r\n",
        "      longitude,\r\n",
        "      place,\r\n",
        "      latitude\r\n",
        "    from\r\n",
        "      silver.earthquake_data_final\r\n",
        "  )\r\n",
        "group by\r\n",
        "  country"
      ],
      "catalog": "demo_dev",
      "schema": "default"
    }
  ],
